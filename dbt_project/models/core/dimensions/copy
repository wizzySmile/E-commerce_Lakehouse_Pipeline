FROM {{ ref('scd2_dim_sellers') }}






SELECT 
    ord.order_id,
    c.customer_key,
    CAST(strftime(
        CAST(ord.order_purchase_date AS date), '%Y%m%d') AS bigint) AS order_date_key,
    ord.order_status,
    DATEDIFF('day', CAST(ord.order_purchase_date AS date), CAST(ord.order_delivered_customer_date AS date)) AS delivery_days_actual,
    DATEDIFF('day', CAST(ord.order_purchase_date AS date), CAST(ord.order_estimated_delivery_date AS date)) AS delivery_days_estimated,
    CASE
        WHEN ord.order_delivered_customer_date > ord.order_estimated_delivery_date THEN TRUE
        ELSE FALSE
    END AS is_late_delivery,
    COUNT(DISTINCT oi.order_item_id) AS total_items,
    COUNT(DISTINCT oi.product_id) AS total_products,
    COALESCE(SUM(oi.price), 0) AS total_order_value,
    COALESCE(SUM(oi.freight_value), 0) AS total_freight_value
FROM {{ ref('stg_orders') }} ord

LEFT JOIN {{ ref('stg_order_items') }} oi
    ON ord.order_id = oi.order_id

LEFT JOIN {{ ref('dim_customers') }} c
  ON c.customer_id = ord.customer_id
  AND c.is_current = true

GROUP BY ALL




SELECT 
    pay.order_id,
    pay.payment_sequential,
    pt.payment_type_key,
    c.customer_key,
    CAST(strftime(
        CAST(order_purchase_date AS date),'%Y%m%d') AS bigint) AS order_date_key,

    pay.payment_installments,
    pay.payment_value

FROM {{ ref('stg_order_payments') }} pay

INNER JOIN {{ ref('stg_orders')}} ord
    ON pay.order_id = ord.order_id

LEFT JOIN {{ ref('dim_customers') }} c
  ON c.customer_id = ord.customer_id
  AND c.is_current = true

LEFT JOIN {{ ref('dim_payment_types') }} pt
    ON  pay.payment_type = pt.payment_type




SELECT
    rev.review_id,
    ord.order_id,
    c.customer_key,
    CAST(strftime(
        CAST(rev.review_creation_date AS date), '%Y%m%d') AS bigint) AS review_date_key,
    CAST(strftime(
        CAST(rev.review_answer_timestamp AS date), '%Y%m%d') AS bigint) AS review_answer_date_key,

    -- days between review created and seller answered
    date_diff('day', CAST(rev.review_creation_date AS date), CAST(rev.review_answer_timestamp AS date)) AS days_to_answer,
    rev.review_score,
    rev.review_comment_title,
    rev.review_comment_message

FROM {{ ref('stg_order_reviews') }} rev

INNER JOIN {{ ref('stg_orders') }} ord
    ON rev.order_id = ord.order_id

LEFT JOIN {{ ref('dim_customers') }} c
  ON c.customer_id = ord.customer_id
  AND c.is_current = true








SELECT 
    oi.order_id,
    oi.order_item_id,

    c.customer_key,
    p.product_key,
    s.seller_key,

    cast(strftime(
        cast (ord.order_purchase_date  AS date), '%Y%m%d') AS bigint) AS order_date_key,

    cast(strftime(
        cast(oi.shipping_limit_date AS date), '%Y%m%d') AS bigint) AS shipping_limit_date_key,

    oi.price,
    oi.freight_value,
    COALESCE(oi.price, 0) + COALESCE(oi.freight_value, 0) AS total_sales_amount

FROM {{ ref('stg_order_items') }} oi

INNER JOIN {{ ref('stg_orders') }} ord
    ON oi.order_id = ord.order_id

-- Joining facts to dims to get surrogate keys
LEFT JOIN {{ ref('dim_customers') }} c
  ON c.customer_id = ord.customer_id
  AND c.is_current = true

LEFT JOIN {{ ref('dim_products') }} p
    ON p.product_id = oi.product_id

LEFT JOIN {{ ref('dim_sellers') }} s
  ON s.seller_id = oi.seller_id
  AND s.is_current = true